{
  "name": "easysubs",
  "version": "3.1.3",
  "description": "Browser extension for learning languages with watching movies and TV shows",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nitrino/easysubs.git"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && cross-env __FIREFOX__=true vite build",
    "build:watch": "cross-env __DEV__=true vite build -w --mode development",
    "build:firefox:watch": "cross-env __DEV__=true __FIREFOX__=true vite build -w --mode development",
    "build:hmr": "rollup --config utils/reload/rollup.config.mjs",
    "wss": "node utils/reload/initReloadServer.js",
    "dev": "pnpm build:hmr && (run-p wss build:watch)",
    "dev:firefox": "pnpm build:hmr && (run-p wss build:firefox:watch)",
    "playground": "vite --config playground/vite.config.ts",
    "playground:movies": "node playground/scripts/download-movies.ts",
    "playground:translations": "node playground/scripts/translation-keys.ts",
    "expressions": "node scripts/expressions/build.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "commitlint": "commitlint --edit",
    "lint": "eslint src playground e2e test scripts",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --write"
  },
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@ifyour/deeplx": "^0.1.17",
    "@vot.js/core": "3.1.5",
    "@vot.js/shared": "3.1.5",
    "anylang": "~3.2.2",
    "classnames": "^2.5.1",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "fflate": "^0.8.3",
    "m3u8-parser": "^7.2.0",
    "patronum": "^2.3.0",
    "qs": "^6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-draggable": "^4.7.2",
    "react-hot-toast": "^2.6.1",
    "react-select": "^5.10.2",
    "stream-browserify": "^3.0.0",
    "subtitle": "^2.0.5",
    "webext-dynamic-content-scripts": "^10.0.5",
    "youtube-caption-extractor": "^1.10.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.23.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/subtitle": "^2.0.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.4.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rollup": "^4.64.0",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
